{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Core identity and health baseline for a user.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "bloodGroup": { "type": "string" },
        "genotype": { "type": "string" },
        "height": { "type": "integer" },
        "weight": { "type": "integer" },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "emergencyContactName": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "stepGoal": { "type": "integer" },
        "subscriptionStatus": { "type": "string", "enum": ["free", "premium"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "bloodGroup", "genotype"]
    },
    "HealthMetric": {
      "title": "Health Metric",
      "description": "A single biometric reading (heart rate, blood pressure, etc).",
      "type": "object",
      "properties": {
        "heartRate": { "type": "number" },
        "bloodPressure": { "type": "string" },
        "stressLevel": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["heartRate", "timestamp"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "A historical conversation session between user and AI Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "assistantType": { "type": "string" },
        "messages": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "assistantType", "messages", "updatedAt"]
    },
    "FoodScan": {
      "title": "Food Scan",
      "description": "NutriScan logged meal entry with calories and macro nutrients.",
      "type": "object",
      "properties": {
        "foodName": { "type": "string" },
        "calories": { "type": "integer" },
        "protein": { "type": "string" },
        "carbs": { "type": "string" },
        "fat": { "type": "string" },
        "insight": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["foodName", "calories", "timestamp"]
    },
    "Notification": {
      "title": "Activity Notification",
      "description": "Real-time activity and health alert push notification.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["vitals", "nutri", "ai", "emergency", "wearable", "system"] },
        "read": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" },
        "actionUrl": { "type": "string" }
      },
      "required": ["title", "body", "type", "read", "timestamp"]
    },
    "FcmToken": {
      "title": "FCM Push Token",
      "description": "Device Firebase Cloud Messaging registration token.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "updatedAt"]
    },
    "NotificationToken": {
      "title": "Notification Token",
      "description": "Multi-device FCM push registration token with platform and device metadata.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "platform": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "enabled": { "type": "boolean" }
      },
      "required": ["token", "updatedAt"]
    },
    "NotificationPreferences": {
      "title": "Notification Preferences",
      "description": "User notification categories and global enable settings.",
      "type": "object",
      "properties": {
        "globalEnabled": { "type": "boolean" },
        "reminders": { "type": "boolean" },
        "hydration": { "type": "boolean" },
        "sleep": { "type": "boolean" },
        "wellness": { "type": "boolean" },
        "product_updates": { "type": "boolean" }
      },
      "required": ["globalEnabled", "reminders", "hydration", "sleep", "wellness", "product_updates"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "/users/{userId}/history/{metricId}": {
      "schema": "HealthMetric",
      "description": "Historical health metrics for the user."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Historical chat sessions with Genova AI assistants."
    },
    "/users/{userId}/foodLogs/{logId}": {
      "schema": "FoodScan",
      "description": "Logged NutriScan meals."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time activity push notifications for the user."
    },
    "/users/{userId}/fcmTokens/{tokenId}": {
      "schema": "FcmToken",
      "description": "Device FCM tokens for sending targeted push notifications."
    },
    "/users/{userId}/notificationTokens/{tokenId}": {
      "schema": "NotificationToken",
      "description": "Multi-device FCM tokens for the user."
    },
    "/users/{userId}/notificationPreferences/{prefId}": {
      "schema": "NotificationPreferences",
      "description": "User notification categories and preferences."
    }
  }
}
