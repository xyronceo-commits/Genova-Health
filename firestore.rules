rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.matches('.*admin.*@genovahealth\\.internal');
    }

    // Phase 4: Entity Validations
    function isValidUserProfile(data) {
      return data.fullName is string && data.fullName.size() <= 200 &&
             data.bloodGroup is string && data.bloodGroup.size() <= 10 &&
             data.genotype is string && data.genotype.size() <= 10 &&
             (data.get('subscriptionStatus', 'free') in ['free', 'premium']) &&
             (data.get('updatedAt', '') is string && data.get('updatedAt', '').size() <= 50);
    }

    function isValidHealthMetric(data) {
      return data.heartRate is number &&
             (data.get('bloodPressure', '') is string && data.get('bloodPressure', '').size() <= 50) &&
             (data.get('stressLevel', 'Low') is string && data.get('stressLevel', 'Low').size() <= 50) &&
             data.timestamp is string && data.timestamp.size() <= 50;
    }

    function isValidChatSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.assistantType is string && data.assistantType.size() <= 50 &&
             data.messages is list && data.messages.size() <= 200 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidFoodScan(data) {
      return data.foodName is string && data.foodName.size() <= 200 &&
             data.calories is number &&
             data.timestamp is string && data.timestamp.size() <= 50;
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.type is string && data.type.size() <= 50 &&
             data.read is bool &&
             data.timestamp is string && data.timestamp.size() <= 50;
    }

    function isValidFcmToken(data) {
      return data.token is string && data.token.size() <= 500 &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidNotificationToken(data) {
      return data.token is string && data.token.size() <= 500 &&
             (data.get('platform', '') is string && data.get('platform', '').size() <= 100) &&
             (data.get('deviceInfo', '') is string && data.get('deviceInfo', '').size() <= 300) &&
             data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidNotificationPreferences(data) {
      return data.globalEnabled is bool &&
             data.reminders is bool &&
             data.hydration is bool &&
             data.sleep is bool &&
             data.wellness is bool &&
             data.product_updates is bool;
    }

    // Collection Rules
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus == 'free') &&
                    (!('role' in incoming()) || incoming().role == 'patient');
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'age', 'gender', 'bloodGroup', 'genotype', 'height', 'weight', 'allergies', 'emergencyContactName', 'emergencyContactPhone', 'stepGoal', 'updatedAt']) &&
                    (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus == existing().get('subscriptionStatus', 'free')) &&
                    (!('role' in incoming()) || incoming().role == existing().get('role', 'patient'));
      
      match /history/{metricId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidHealthMetric(incoming());
      }

      match /chats/{chatId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidChatSession(incoming());
        allow delete: if isOwner(userId);
      }

      match /foodLogs/{logId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidFoodScan(incoming());
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidNotification(incoming());
      }

      match /fcmTokens/{tokenId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidFcmToken(incoming());
      }

      match /notificationTokens/{tokenId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) && isValidNotificationToken(incoming());
      }

      match /notificationPreferences/{prefId} {
        allow list, get: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidNotificationPreferences(incoming());
      }

      match /waterLogs/{logId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, delete: if isOwner(userId);
      }

      match /moodLogs/{logId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, delete: if isOwner(userId);
      }
    }
    
    // Support Test connection Doc
    match /test/connection {
      allow get: if true; 
    }
  }
}
